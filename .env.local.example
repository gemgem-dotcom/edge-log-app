# Copy this file to .env.local and fill in your real values from Supabase.
# Project Settings → API in your Supabase dashboard.
# .env.local is never uploaded to GitHub (see .gitignore) — it's how
# secrets stay out of your public code.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
