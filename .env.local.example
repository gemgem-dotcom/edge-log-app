# Copy this file to .env.local and fill in your real values from Supabase.
# Project Settings -> API in your Supabase dashboard.
# .env.local is never uploaded to GitHub (see .gitignore) - that is how
# secrets stay out of your public code.
#
# All of these also need to be set in Vercel:
# Project Settings -> Environment Variables.

# Safe to expose - these two are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY - never share this, and never rename it with a
# NEXT_PUBLIC_ prefix. It bypasses row level security and has full admin
# access to your database. It is only read by the API routes in
# app/api/ (recording sign-ins, and deleting an account).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The economic calendar, volatility, and key-levels cards on the Overview
# pages currently show mock/placeholder data (lib/marketContextMock.js) -
# no key needed for those yet. See NOTES.md.

# SERVER ONLY - never rename with a NEXT_PUBLIC_ prefix. Used by
# lib/databento.js (historical market data, NQ only - see NOTES.md) to
# authenticate with Databento's Historical API. Only the daily
# market-session-stats job reads this; nothing in the browser needs it.
DATABENTO_API_KEY=your-databento-api-key

# Optional - Sentry error tracking (systems-map audit finding #2). A DSN is
# meant to be public (it can only send events in, never read anything back
# out), which is why this is NEXT_PUBLIC_ rather than server-only - read by
# the browser (instrumentation-client.js), the server/edge runtimes
# (sentry.server.config.js / sentry.edge.config.js), and the two Databento
# scheduled scripts (as a GitHub Actions repo secret - see .github/workflows
# /refresh-market-session-stats.yml's own comment). Leaving this unset is
# safe - every Sentry.init() call in this app no-ops without it.
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
