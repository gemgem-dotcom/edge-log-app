# Copy this file to .env.local and fill in your real values from Supabase.
# Project Settings -> API in your Supabase dashboard.
# .env.local is never uploaded to GitHub (see .gitignore) - that is how
# secrets stay out of your public code.
#
# Both of these also need to be set in Vercel:
# Project Settings -> Environment Variables.

# Safe to expose - these two are sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY - never share this, and never rename it with a
# NEXT_PUBLIC_ prefix. It bypasses row level security and has full admin
# access to your database. It is only read by the API routes in
# app/api/ (recording sign-ins, and deleting an account).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# No key needed for the economic calendar card on the All Instruments
# dashboard (app/api/economic-calendar) - it reads BLS's public iCalendar
# feed plus a hand-maintained FOMC date list, both key-free.
